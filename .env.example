# ARKITEKT — copie para .env e preencha. .env está no .gitignore.

# rota principal: Flux + ControlNet depth (pago por uso, ~US$0,05/imagem)
FAL_KEY=

# rota alternativa / segunda opinião (opcional)
REPLICATE_API_TOKEN=
ARKITEKT_REPLICATE_MODEL=black-forest-labs/flux-depth-dev

# ComfyUI self-hosted (opcional, só compensa acima de ~1.500 imagens/mês)
ARKITEKT_COMFY_URL=
ARKITEKT_GPU_USD_HOUR=0.60
