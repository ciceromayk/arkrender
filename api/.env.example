# ARKITEKT API — copie para api/.env e preencha.
# Supabase → Settings → API: pegue URL, service_role key e o JWT Secret.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# URL(s) do web/ que podem chamar esta API, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# fal.ai → Settings → Keys. Esta é a chave DO OPERADOR — paga a geração
# de todos os usuários, ao contrário do app/streamlit_app.py onde cada um
# colava a própria chave.
FAL_KEY=
